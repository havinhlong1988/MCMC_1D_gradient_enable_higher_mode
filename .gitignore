__pycache__/
*.pyc

# macOS build scratch (generated by Makefile, see Codes/MCMC_flex/Makefile)
Codes/MCMC_flex/macbuild/
.DS_Store

# ---------------------------------------------------------------------------
# Compiled build artifacts (Codes/MCMC_flex).
# These are PLATFORM-SPECIFIC: Linux/CentOS produces ELF x86-64, macOS produces
# Mach-O arm64.  They used to be committed, which meant every switch between
# the Mac and the CentOS box rewrote them and produced unmergeable binary
# conflicts -- and a CentOS checkout could end up with macOS objects that fail
# to link.  They are now built on each machine from the tracked .f/.C sources
# (`make do_MC_Para`), so they must not be tracked.
Codes/MCMC_flex/DISP2/*.o
Codes/MCMC_flex/RF/*.o
Codes/MCMC_flex/*.o
Codes/MCMC_flex/do_MC_Para
Codes/MCMC_flex/do_MC_Para_Post_process_v3
